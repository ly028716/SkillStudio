{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "tsBuildInfoFile": "../../node_modules/.cache/skillstudio/web.tsbuildinfo"
  },
  "include": [
    "package.json",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "../../packages/contracts/src/**/*.ts"
  ],
  "references": [
    {
      "path": "../../packages/contracts"
    }
  ]
}
