{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "@skillstudio/contracts": [
        "../contracts/dist/index.d.ts"
      ],
      "@skillstudio/harness-core": [
        "../harness-core/dist/index.d.ts"
      ],
      "@skillstudio/skill-core": [
        "../skill-core/dist/index.d.ts"
      ]
    },
    "tsBuildInfoFile": "../../node_modules/.cache/skillstudio/connector.tsbuildinfo"
  },
  "include": [
    "package.json",
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../../packages/contracts"
    },
    {
      "path": "../../packages/harness-core"
    },
    {
      "path": "../../packages/skill-core"
    }
  ]
}
